# ════════════════════════════════════════════════════════════════
# ЕДИНАЯ ДИЗАЙН-СИСТЕМА
# Все цвета, отступы и размеры собраны в одном месте, чтобы экраны
# выглядели одинаково независимо от устройства/производителя и от
# того, какую тему (theme_cls) выставил пользователь в системе —
# цвета зафиксированы явно, а не берутся из app.theme_cls.
# ════════════════════════════════════════════════════════════════

#:set COLOR_BG       (0.953, 0.949, 0.973, 1)   # светлый лавандово-серый фон (как на сайте)
#:set COLOR_SURFACE  (1, 1, 1, 1)               # белые карточки
#:set COLOR_HEADER   (0.420, 0.161, 0.851, 1)   # фирменный фиолетовый «Миранда» — шапка
#:set COLOR_DARK     (0.106, 0.106, 0.118, 1)   # тёмный текст (как в навигации сайта)
#:set COLOR_ON_DARK  (1, 1, 1, 1)               # белый текст на фиолетовом/оранжевом/красном
#:set COLOR_PRIMARY  (0.949, 0.349, 0.129, 1)   # фирменный оранжевый «Миранда» — акцент/кнопки
#:set COLOR_DANGER   (0.851, 0.204, 0.204, 1)   # красный для опасных действий
#:set COLOR_SUCCESS  (0.60, 0.87, 0.40, 1)     # салатовый для успешных действий

#:set SPACE_XS  "4dp"
#:set SPACE_SM  "8dp"
#:set SPACE_MD  "12dp"
#:set SPACE_LG  "16dp"

#:set SIZE_BAR     "56dp"   # высота шапки
#:set SIZE_ROW     "56dp"   # высота строки с полем ввода
#:set SIZE_BUTTON  "48dp"   # высота обычной кнопки
#:set RADIUS_CARD  [16, 16, 16, 16]

# ── Единый стиль кнопки (скруглённый прямоугольник + текст) ──
<RoundedButton@Button>:
    background_normal: ""
    background_down: ""
    background_color: (0.420, 0.161, 0.851, 1)     # COLOR_HEADER — как шапка
    color: (1, 1, 1, 1)                              # COLOR_ON_DARK — белый текст
    disabled_color: (1, 1, 1, 0.5)                   # белый полупрозрачный, когда кнопка отключена
    size_hint: 1, None
    height: SIZE_BUTTON
    bold: True
    font_size: "14sp"

    canvas.before:
        Color:
            rgba: (0.42, 0.16, 0.85, 0.4) if self.disabled else (self.background_color if self.background_color else (0.42, 0.16, 0.85, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10, 10, 10, 10]

<FixedDropDownItem@MDDropDownItem>:
    size_hint_y: None
    height: "56dp"
    pos_hint: {"center_y": .5}
    padding: "8dp", "8dp"


<ScreenHeader@MDBoxLayout>:
    title: ""
    left_icon: ""
    badge_text: ""
    left_action: lambda: None
    left_icon_2: ""
    left_action_2: lambda: None
    left_icon_3: ""
    left_action_3: lambda: None
#    left_icon_3_badge_text: ""
    badge_text: ""                    # ← ДОЛЖНО БЫТЬ
    right_icon: ""
    right_action: lambda: None
    right_icon_2: ""
    right_action_2: lambda: None
    orientation: "horizontal"
    size_hint_y: None
    height: SIZE_BAR
    padding: SPACE_XS, 0
    spacing: 0
    md_bg_color: COLOR_HEADER

    MDIconButton:
        icon: root.left_icon or "checkbox-blank-circle-outline"
        opacity: 1 if root.left_icon else 0
        disabled: not root.left_icon
        theme_text_color: "Custom"
        text_color: COLOR_ON_DARK
        on_release: root.left_action()

    MDIconButton:
        icon: root.left_icon_2 or "checkbox-blank-circle-outline"
        opacity: 1 if root.left_icon_2 else 0
        disabled: not root.left_icon_2
        size_hint_x: None
        width: "48dp" if root.left_icon_2 else "0dp"
        theme_text_color: "Custom"
        text_color: COLOR_ON_DARK
        on_release: root.left_action_2()

    FloatLayout:
        size_hint: None, None
        width: "48dp" if root.left_icon_3 else "0dp"
        height: SIZE_BAR
        opacity: 1 if root.left_icon_3 else 0
        disabled: not root.left_icon_3

        MDIconButton:
            icon: root.left_icon_3 or "checkbox-blank-circle-outline"
            theme_text_color: "Custom"
            text_color: COLOR_ON_DARK
            on_release: root.left_action_3()
            pos_hint: { "center_x": .5, "center_y": .5 }

        # ── Бейдж с количеством ──
        Label:
            id: badge
            text: root.badge_text
            opacity: 1 if root.badge_text else 0
            size_hint: None, None
            size: "18dp", "18dp"
            pos_hint: { "right": 1, "top": 1 }
            halign: "center"
            valign: "middle"
            font_size: "10sp"
            bold: True
            color: 1, 1, 1, 1
            text_size: self.size
            canvas.before:
                Color:
                    rgba: (0.9, 0.2, 0.2, 1)
                Ellipse:
                    pos: self.pos
                    size: self.size

    MDLabel:
        text: root.title
        theme_text_color: "Custom"
        text_color: COLOR_ON_DARK
        bold: True
        valign: "middle"
        padding: SPACE_SM, 0

    Widget:
        # растяжка — прижимает правые иконки к краю

    MDIconButton:
        icon: root.right_icon_2 or "checkbox-blank-circle-outline"
        opacity: 1 if root.right_icon_2 else 0
        disabled: not root.right_icon_2
        size_hint_x: None
        width: "48dp" if root.right_icon_2 else "0dp"
        theme_text_color: "Custom"
        text_color: COLOR_ON_DARK
        on_release: root.right_action_2()

    MDIconButton:
        icon: root.right_icon or "checkbox-blank-circle-outline"
        opacity: 1 if root.right_icon else 0
        disabled: not root.right_icon
        size_hint_x: None
        width: "48dp" if root.right_icon else "0dp"
        theme_text_color: "Custom"
        text_color: COLOR_ON_DARK
        on_release: root.right_action()


# ── Единая карточка для вывода текста (мягкое скругление + тень
#    вместо плоского белого прямоугольника — аккуратнее и современнее) ──
# ── Единый стиль кнопок: neutral / primary / danger ──
# Кнопка рисует фон сама (canvas), а не через MDFlatButton.md_bg_color —
# в некоторых версиях KivyMD MDFlatButton рендерит текст через внутренний
# дочерний виджет и просто игнорирует md_bg_color/text_color, заданные
# напрямую (именно из-за этого кнопки были «бесцветными»). Самостоятельная
# отрисовка гарантированно работает в любой версии библиотеки.
# ── Единый стиль кнопок: neutral / primary / danger ──
# ── Единый стиль кнопок: neutral / primary / danger ──



# ────────────────────────────────────────────────────────────────
# GOORANDA
# ────────────────────────────────────────────────────────────────
<GoorandaWindow>:
    name: "Gooranda"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        ScreenHeader:
            id: gooranda_header
            title: "Gooranda"
            left_icon: "arrow-up-bold"
            left_action: lambda: app.go_to("SettingsWindow")
            left_icon_2: "radio-tower"
            left_action_2: lambda: app.go_to("TorusWindow")
            left_icon_3: "account-group"
            left_action_3: lambda: app.go_to("BirthdayWindow")
            right_icon: "swap-horizontal"
            right_action: lambda: app.go_to("Uber")

        MDBoxLayout:
            orientation: "vertical"
            padding: SPACE_MD
            spacing: SPACE_MD

            # ── Карточка вывода ──
            MDBoxLayout:
                orientation: "vertical"
                padding: SPACE_SM
                size_hint_y: 0.55
                md_background_color: COLOR_SURFACE

#                SelectableLabel:
#                    id: output_text
#                    text: ""
#                    font_size: "15sp"

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    MDTextField:
                        id: output_text
                        
                        input_type: "text"  # 👈 Добавь эту строку
                        #hint_text: "Описание работ (свой вариант)"
    #                    mode: "rectangle"
                        multiline: True
    #                    size_hint_y: None
    #                    max_height: "120dp"

            MDBoxLayout:
                size_hint_y: None
                height: SIZE_BUTTON
                spacing: SPACE_SM

                RoundedButton:
                    text: "КОПИРОВАТЬ"
                    height: "48dp"        # ← добавить, чтобы не «плыло»
                    disabled: output_text.text == ""
                    on_release: root.copy_to_clipboard(output_text.text)

                RoundedButton:
                    text: "НАВИГАТОР"
                    background_color: COLOR_PRIMARY
                    color: COLOR_ON_DARK
                    height: "48dp"        # ← добавить, чтобы не «плыло»
                    disabled: output_text.text == ''
                    on_release: root.open_browser(root.route)

            MDBoxLayout:
                size_hint_y: None
                height: SIZE_ROW
                spacing: SPACE_SM

                FixedDropDownItem:
                    id: spinner_id
                    text: "БС"
                    on_release: app.open_mode_menu(spinner_id)

                MDTextField:
                    id: bs_name
                    hint_text: "Номер БС "
                    input_type: "text"  # 👈 Добавь эту строку
                    mode: "rectangle"
                    text_validate_unfocus: False
                    on_text_validate: root.make_output()

                RoundedButton:
                    text: "GO"
                    background_color: COLOR_PRIMARY
                    color: COLOR_ON_DARK
                    size_hint_x: None
                    width: "80dp"
                    height: "50dp"        # ← добавить, чтобы не «плыло»
                    on_release: root.make_output()


# ─────────────────────────────────────────────────
# WORKER
# ─────────────────────────────────────────────────
<WorkerWindow>:
    name: "WorkerWindow"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: COLOR_BG

        ScreenHeader:
            title: "Выбор сотрудников"
            left_icon: "arrow-left"
            left_action: lambda: app.go_back("Uber")
            right_icon: "upload"
            right_action: lambda: root.import_workers_dialog()
            right_icon_2: "download"
            right_action_2: lambda: root.export_workers_xlsx()

        # ── Поиск ──
        # ── Поиск + кнопка Очистить ──
        MDBoxLayout:
            size_hint_y: None
            height: "76dp"
            padding: [ SPACE_MD, "20dp", SPACE_MD, SPACE_XS ]
            spacing: SPACE_SM

            MDTextField:
                id: search_field
                input_type: "text"
                hint_text: "Поиск по фамилии…"
                mode: "rectangle"
                size_hint_y: None
                height: "48dp"
                pos_hint: { "center_y": .5 }
                on_text: root.filter_workers(self.text)

            RoundedButton:
                text: "ОЧИСТИТЬ"
                background_color: COLOR_DARK
                color: COLOR_ON_DARK
                size_hint_x: None
                width: "120dp"
                height: "48dp"
                pos_hint: { "center_y": .5 }
                on_release: root.clear_search()

        # ── Счётчик + Снять все ──
        MDBoxLayout:
            size_hint_y: None
            height: "36dp"
            padding: SPACE_MD, 0
            spacing: SPACE_SM

            MDLabel:
                id: selected_count_label
                text: "Выбрано: 0"
                theme_text_color: "Custom"
                text_color: COLOR_DARK
                font_size: "14sp"
                valign: "middle"

            Widget:

            RoundedButton:
                text: "Снять все"
                size_hint_x: None
                size_hint_y: None
                width: "110dp"
                height: "32dp"
                pos_hint: {"center_y": .5}
                background_color: COLOR_DARK
                color: COLOR_ON_DARK
                font_size: "12sp"
                on_release: root.clear_all_selections()

        # ── Сетка чекбоксов ── ← ГЛАВНОЕ: id здесь
        MDScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: "4dp"

            MDGridLayout:
                id: checkbox_container
                cols: 2
                spacing: "4dp"
                padding: SPACE_SM
                size_hint_y: None
                height: self.minimum_height
                row_default_height: "44dp"
                row_force_default: True

        # ── Нижние кнопки ──
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: SIZE_ROW
            spacing: SPACE_SM
            padding: SPACE_SM

            RoundedButton:
                text: "+ Добавить сотрудника"
                background_color: COLOR_PRIMARY
                color: COLOR_ON_DARK
                on_release: root.add_worker_dialog()

            RoundedButton:
                text: "− Удалить сотрудника"
                background_color: COLOR_DANGER
                color: COLOR_ON_DARK
                on_release: root.delete_worker_dialog()


# ────────────────────────────────────────────────────────────────
# RESPONSIBLES
# ────────────────────────────────────────────────────────────────
<ResponsiblesWindow>:
    name: "Responsibles"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        ScreenHeader:
            title: "Ответственный за заявку"
            left_icon: "arrow-left"
            left_action: lambda: app.go_back("Uber")

        MDScrollView:
            MDList:
                id: respons_checkbox_container


# ────────────────────────────────────────────────────────────────
# CRWO
# ────────────────────────────────────────────────────────────────
<CrwoWindow>:
    name: "CrwoWindow"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        ScreenHeader:
            title: "Готовая заявка"
            left_icon: "arrow-left"
            left_action: lambda: app.go_back("Uber")

        MDBoxLayout:
            orientation: "vertical"
            padding: SPACE_MD
            spacing: SPACE_MD

            MDBoxLayout:
                orientation: "vertical"
                padding: SPACE_SM
                size_hint_y: 0.85
                md_background_color: COLOR_SURFACE

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    MDTextField:
                        id: crwo_text_output
                        input_type: "text"  # 👈 Добавь эту строку
                        multiline: True

            MDBoxLayout:
                size_hint_y: None
                height: SIZE_BUTTON
                spacing: SPACE_SM

                RoundedButton:
                    text: "КОПИРОВАТЬ"
                    on_release: root.copy_to_clipboard(crwo_text_output.text)

                RoundedButton:
                    text: "НАЗАД"
                    background_color: COLOR_PRIMARY
                    color: COLOR_ON_DARK
                    on_release: app.go_back("Uber")


# ────────────────────────────────────────────────────────────────
# UBER — главный экран
# ────────────────────────────────────────────────────────────────
# ────────────────────────────────────────────────────────────────
# UBER — главный экран
# ────────────────────────────────────────────────────────────────
# ────────────────────────────────────────────────────────────────
# UBER — главный экран
# ────────────────────────────────────────────────────────────────
<UberWindow>:
    name: "Uber"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        ScreenHeader:
            title: "Uber"
            left_icon: "swap-horizontal"
            left_action: lambda: app.go_back("Gooranda")

        MDScrollView:
            do_scroll_x: False
            do_scroll_y: True

            MDBoxLayout:
                orientation: "vertical"
                padding: SPACE_MD
                spacing: SPACE_SM
                size_hint_y: None
                height: self.minimum_height

                # ── Номер CRWO (симметрично: -1 | поле | +1) ──
                MDBoxLayout:
                    size_hint_y: None
                    height: SIZE_ROW
                    spacing: SPACE_SM

                    RoundedButton:
                        text: "-1"
                        size_hint_x: None
                        width: "60dp"
                        height: "48dp"
                        pos_hint: {"center_y": .5}
                        on_release: root.crwo_decrement(root.ids.crwo_number.text)

                    MDTextField:
                        id: crwo_number
                        hint_text: "Номер CRWO"
                        input_type: "text"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "48dp"
                        pos_hint: {"center_y": .5}

                    RoundedButton:
                        text: "+1"
                        size_hint_x: None
                        width: "60dp"
                        height: "48dp"
                        pos_hint: {"center_y": .5}
                        on_release: root.crwo_increment(root.ids.crwo_number.text)

                # ── БС (спиннер | поле | Очистить) ──
                MDBoxLayout:
                    size_hint_y: None
                    height: SIZE_ROW
                    spacing: SPACE_SM

                    FixedDropDownItem:
                        id: moto_spinner
                        text: "БС"
                        size_hint_x: None
                        width: "100dp"
                        pos_hint: {"center_y": .5}
                        on_release: app.open_moto_menu(moto_spinner)

                    MDTextField:
                        id: bs_name
                        hint_text: "Номер БС"
                        input_type: "text"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "48dp"
                        pos_hint: {"center_y": .5}

                    RoundedButton:
                        text: "Очистить"
                        background_color: COLOR_DANGER
                        color: COLOR_ON_DARK
                        size_hint_x: None
                        width: "100dp"
                        height: "48dp"
                        pos_hint: {"center_y": .5}
                        on_release: root.clear_bs_name()

                # ── Чекбокс «Единой заявкой» — ПОД полем Номер БС ──
                MDBoxLayout:
                    id: single_request_box
                    size_hint_y: None
                    height: "30dp"
                    spacing: SPACE_SM
                    pos_hint: {"center_x": .5}

                    MDCheckbox:
                        id: single_request_checkbox
                        size_hint: None, None
                        size: "30dp", "30dp"
                        pos_hint: {"center_y": .5}
                        active: False if self.disabled else self.active

                    MDLabel:
                        text: "Единой заявкой"
                        font_style: "Body1"
                        theme_text_color: "Hint" if self.disabled else "Primary"
                        valign: "middle"
                        pos_hint: {"center_y": .5}

                # ── Регион / Организация (50/50) ──
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: SIZE_ROW
                    spacing: SPACE_SM

                    FixedDropDownItem:
                        id: region_short
                        text: "FEO"
                        size_hint_x: 0.5
                        pos_hint: {"center_y": .5}
                        on_release: app.open_region_menu(region_short)

                    FixedDropDownItem:
                        id: organization
                        text: "Миранда-Медиа"
                        size_hint_x: 0.5
                        pos_hint: {"center_y": .5}
                        on_release: app.open_organization_menu(organization)

                # ── Тип работ + тип запитки (50/50) ──
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: SIZE_ROW
                    spacing: SPACE_SM

                    FixedDropDownItem:
                        id: work_type
                        text: "🔋 ДГУ"
                        size_hint_x: 0.5
                        pos_hint: {"center_y": .5}
                        on_release: app.open_work_type_menu(work_type)

                    FixedDropDownItem:
                        id: work_description_spinner
                        text: "🪫 Запитать БС от ДГУ"
                        size_hint_x: 0.5
                        pos_hint: {"center_y": .5}
                        on_release: app.open_work_desc_menu(work_description_spinner)

                # ── Своё описание работ (схлопнута по умолчанию) ──
                MDBoxLayout:
                    id: custom_desc_box
                    orientation: "horizontal"
                    size_hint_y: None
                    height: 0
                    opacity: 0
                    disabled: True
                    spacing: SPACE_SM

                    MDTextField:
                        id: work_description
                        input_type: "text"
                        hint_text: "Описание работ (свой вариант)"
                        mode: "rectangle"
                        multiline: True
                        size_hint_y: None
                        max_height: "120dp"

                    RoundedButton:
                        text: "Очистить"
                        size_hint_x: None
                        background_color: COLOR_DANGER
                        color: COLOR_ON_DARK
                        width: "100dp"
                        size_hint_y: None
                        height: "48dp"
                        pos_hint: {"center_y": .5}
                        on_release: root.clear_description()

                # ── Время ──
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: SIZE_ROW
                    spacing: SPACE_SM

                    FixedDropDownItem:
                        id: time_to_go_spinner
                        text: "Назначить время"
                        size_hint_x: 1
                        pos_hint: {"center_y": .5}
                        on_release: app.open_time_menu(time_to_go_spinner)

                # ── Label «Выбери исполнителей» — КРАСНЫЙ ──
                MDBoxLayout:
                    size_hint_y: None
                    height: SIZE_BUTTON
                    spacing: SPACE_SM

                    MDLabel:
                        id: choose_workers_label
                        text: "Выбери исполнителей:"
                        font_style: "Body1"
                        theme_text_color: "Custom"
                        text_color: COLOR_DARK if root.workers_selected else COLOR_DANGER
                        bold: not root.workers_selected
                        halign: "center"
                        valign: "middle"
                        text_size: self.size
                        pos_hint: { "center_y": .5 }

                # ── Кнопка «Выбрать сотрудников» — ПО ЦЕНТРУ ──
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: SIZE_ROW
                    spacing: SPACE_SM

                    Widget:

                    RoundedButton:
                        text: "Выбрать сотрудников"
                        size_hint_x: None
                        width: "260dp"
                        height: "48dp"
                        pos_hint: {"center_y": .5}
                        on_release: app.go_to("WorkerWindow")

                    Widget:

                # ── Ответственный: режим ввода ──
                MDBoxLayout:
                    id: respo_edit_box
                    orientation: "horizontal"
                    size_hint_y: None
                    height: SIZE_ROW
                    spacing: SPACE_SM

                    MDTextField:
                        id: respo_worker
                        hint_text: "Выдал заявку (Фамилия)"
                        input_type: "text"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "48dp"
                        pos_hint: {"center_y": .5}
                        on_text_validate: root.assign_responsible()

                    RoundedButton:
                        text: "Присвоить"
                        size_hint_x: None
                        height: "48dp"
                        width: "120dp"
                        pos_hint: {"center_y": .5}
                        on_press: root.assign_responsible()

                # ── Ответственный: режим просмотра ──
                MDBoxLayout:
                    id: respo_view_box
                    orientation: "horizontal"
                    size_hint_y: None
                    height: 0
                    opacity: 0
                    disabled: True
                    spacing: SPACE_SM

                    MDLabel:
                        id: respo_view_label
                        text: ""
                        theme_text_color: "Custom"
                        text_color: COLOR_DARK
                        font_style: "Body1"
                        valign: "middle"
                        padding: SPACE_MD, 0

                    # ── Кнопка «Изменить» — высота уменьшена вдвое (24dp) ──
                    RoundedButton:
                        text: "Изменить"
                        size_hint_x: None
                        width: "120dp"
                        height: "24dp"
                        pos_hint: {"center_y": .5}
                        on_release: root.edit_responsible()

        # ── Кнопка формирования (по центру) ──
        FloatLayout:
            size_hint: 1, None
            height: "96dp"

            RoundedButton:
                text: "СФОРМИРОВАТЬ ЗАЯВКУ"
                background_color: COLOR_PRIMARY
                color: COLOR_ON_DARK
                size_hint: None, None
                size: "250dp", "64dp"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                on_release:
                    root.write_crwo_list(crwo_number.text)
                    app.go_to("CrwoWindow")
                    root.start()

# тестовый коммент
# ────────────────────────────────────────────────────────────────
# SETTINGS
# ────────────────────────────────────────────────────────────────
<SettingsWindow>:
    name: "SettingsWindow"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        ScreenHeader:
            title: "Настройки: обновление БД"
            left_icon: "arrow-left"
            left_action: lambda: app.go_back("Gooranda")

        MDBoxLayout:
            orientation: "vertical"
            padding: SPACE_LG
            spacing: SPACE_LG

            MDLabel:
                text: "Выберите файл Excel (.xls, .xlsx, .csv) для обновления базы данных."
                halign: "center"
                size_hint_y: None
                height: "60dp"

            RoundedButton:
                text: "ВЫБРАТЬ ФАЙЛ"
                background_color: COLOR_PRIMARY
                color: COLOR_ON_DARK
                pos_hint: {"center_x": 0.5}
                on_release: root.open_file_manager()



# ────────────────────────────────────────────────────────────────
# TORUS
# ────────────────────────────────────────────────────────────────
<TorusWindow>:
    name: "TorusWindow"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        ScreenHeader:
            id: torus_header
            title: "Torus: выбор документа"
            left_icon: "arrow-left"
            left_action: lambda: app.go_back("Gooranda")

        MDBoxLayout:
            orientation: "vertical"
            padding: SPACE_LG
            spacing: SPACE_LG

            MDLabel:
                text: "Выберите регион и документ Torus (.xls, .xlsx, .csv)"
                halign: "center"
                size_hint_y: None
                height: "40dp"

            FixedDropDownItem:
                id: dropdown_region
                text: "FEO"
                pos_hint: {"center_x": 0.5}
                on_release: app.open_region_menu(self)

            RoundedButton:
                id: torus_again
                text: "AGAIN"
                pos_hint: {"center_x": 0.5}
                on_release: root.torus_again()

            RoundedButton:
                text: "ВЫБРАТЬ ФАЙЛ"
                background_color: COLOR_PRIMARY
                color: COLOR_ON_DARK
                pos_hint: {"center_x": 0.5}
                on_release: root.open_file_manager()


# ────────────────────────────────────────────────────────────────
# NETWORK TABS
# ────────────────────────────────────────────────────────────────
# Шапка здесь не вынесена в ScreenHeader: заголовок (id: app_bar)
# обновляется из Python-кода (root.ids.app_bar.text = ...), поэтому
# id обязан остаться напрямую в дереве этого экрана.
<NetworkTabsWindow>:
    name: "NetworkTabsWindow"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: SIZE_BAR
            padding: SPACE_XS, 0

            canvas.before:
                Color:
                    rgba: COLOR_HEADER
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIconButton:
                icon: "arrow-left"
                theme_text_color: "Custom"
                text_color: COLOR_ON_DARK
                on_release: root.go_back()

            MDLabel:
                id: app_bar
                text: "Torus: результаты"
                theme_text_color: "Custom"
                text_color: COLOR_ON_DARK
                bold: True
                valign: "middle"
                padding: SPACE_SM, 0

        MDTabs:
            id: tabs

            MyTab:
                title: "GSM/DCS"

                SelectableLabel:
                    id: gsm
                    text: ""

            MyTab:
                title: "UMTS"

                SelectableLabel:
                    id: umts
                    text: ""

            MyTab:
                title: "LTE"

                SelectableLabel:
                    id: lte
                    text: ""

        MDBoxLayout:
            size_hint_y: None
            height: SIZE_BAR
            spacing: SPACE_SM
            padding: SPACE_SM

            RoundedButton:
                text: "НАЗАД"
                on_release: root.go_back()

            RoundedButton:
                text: "КОПИРОВАТЬ"
                background_color: COLOR_PRIMARY
                color: COLOR_ON_DARK
                on_release: root.copy_current_tab()

            RoundedButton:
                text: "ОТМЕНА"
                background_color: COLOR_DANGER
                color: COLOR_ON_DARK
                on_release: root.go_cancel()


<MyTab>:
    orientation: "vertical"


<CheckboxItem>:
    theme_text_color: "Primary"

# ────────────────────────────────────────────────────────────────
# BIRTHDAY — дни рождения сотрудников
# ────────────────────────────────────────────────────────────────
<BirthdayWindow>:
    name: "BirthdayWindow"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: COLOR_BG

        ScreenHeader:
            title: "Дни рождения"
            left_icon: "arrow-left"
            left_action: lambda: app.go_back("Gooranda")
            right_icon: "upload"
            right_action: lambda: root.import_birthdays_dialog()

        MDTabs:
            id: birthday_tabs

            MyTab:
                title: "7 дней"
                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: "4dp"

                    MDLabel:
                        id: week_tab
                        text: "Загрузка…"
                        markup: True
                        theme_text_color: "Custom"
                        text_color: COLOR_DARK
                        font_size: "15sp"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        padding: SPACE_MD, SPACE_SM

            MyTab:
                title: "30 дней"
                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: "4dp"

                    MDLabel:
                        id: month_tab
                        text: "Загрузка…"
                        markup: True
                        theme_text_color: "Custom"
                        text_color: COLOR_DARK
                        font_size: "15sp"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        padding: SPACE_MD, SPACE_SM

            MyTab:
                title: "Все"
                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    bar_width: "4dp"

                    MDLabel:
                        id: all_tab
                        text: "Загрузка…"
                        markup: True
                        theme_text_color: "Custom"
                        text_color: COLOR_DARK
                        font_size: "14sp"
                        size_hint_y: None
                        height: self.texture_size[1]
                        text_size: self.width, None
                        padding: SPACE_MD, SPACE_SM


# ────────────────────────────────────────────────────────────────
# LOGIN — вход / регистрация
# Логика — в login_screen.py (LoginWindow), хранение — в db.py (SQLite).
# ────────────────────────────────────────────────────────────────
<LoginWindow>:
    name: "LoginWindow"

    MDBoxLayout:
        orientation: "vertical"
        md_background_color: COLOR_BG

        ScreenHeader:
            title: "Вход"

        MDBoxLayout:
            orientation: "vertical"
            padding: SPACE_LG
            spacing: SPACE_MD

            Widget:
                # верхний растягивающийся отступ — центрирует форму по высоте

            MDTextField:
                id: first_name
                hint_text: "Имя"
                mode: "rectangle"
                input_type: "text"  # 👈 Добавь эту строку
                size_hint_y: None
                height: SIZE_ROW
                size_hint_y: None
                height: "48dp"
                pos_hint: { "center_y": .5 }

            MDTextField:
                id: last_name
                hint_text: "Фамилия"
                input_type: "text"  # 👈 Добавь эту строку
                mode: "rectangle"
                size_hint_y: None
                height: SIZE_ROW
                pos_hint: { "center_y": .5 }

            MDBoxLayout:
                size_hint_y: None
                height: SIZE_ROW
                spacing: SPACE_SM

                MDTextField:
                    id: password
                    hint_text: "Пароль"
                    input_type: "text"  # 👈 Добавь эту строку
                    mode: "rectangle"
                    password: True
                    on_text_validate: root.login()

                MDIconButton:
                    id: password_toggle
                    icon: "eye"
                    theme_text_color: "Custom"
                    text_color: COLOR_DARK
                    on_release: root.toggle_password_visibility()

            MDLabel:
                id: error_label
                text: ""
                theme_text_color: "Custom"
                text_color: COLOR_DANGER
                size_hint_y: None
                height: "24dp"
                halign: "center"

            MDBoxLayout:
                size_hint_y: None
                height: SIZE_BUTTON
                spacing: SPACE_SM

                RoundedButton:
                    text: "ЗАРЕГИСТРИРОВАТЬСЯ"
                    on_release: root.register()

                RoundedButton:
                    text: "ВОЙТИ"
                    background_color: COLOR_PRIMARY
                    color: COLOR_ON_DARK
                    on_release: root.login()

            Widget:
                # нижний растягивающийся отступ
